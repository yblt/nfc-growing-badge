# 复制为 .env 后按需修改；全部有代码内默认值
# 当前本机运行时 = llama.cpp 免安装版（见 docs/llama-runtime.md；启动：scripts/run-llama.ps1）
# 若改回 Ollama：BASE_URL=http://localhost:11434/v1，MODEL=qwen3:4b
PORT=3000
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=qwen3-4b
# 反思摘要用小档或云端 API：REFLECT_MODEL=deepseek-v3 + 独立 BASE_URL 时另加实现
REFLECT_MODEL=qwen3-1.7b
CONTEXT_TURNS=12
PERSONA_FILE=./personas/template.md
